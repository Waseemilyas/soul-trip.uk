#!/usr/bin/env bash
set -euo pipefail

# git feeds a pre-push hook its ref list on STDIN exactly ONCE, and the gitleaks
# scan below drains stdin while it runs. Capture the list up front so anything
# added after this block can still see the refs.
REFS="$(cat)"

red='\033[0;31m'; yellow='\033[1;33m'; green='\033[0;32m'; nc='\033[0m'

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --redact --config .gitleaks.toml --no-banner >/dev/null 2>&1; then
    echo -e "${red}✗ Push blocked:${nc} gitleaks found potential secrets in repository history."
    echo -e "Run: gitleaks git --redact --config .gitleaks.toml"
    exit 1
  fi
else
  echo -e "${yellow}! gitleaks not installed; running basic fallback scan.${nc}"
  suspect=$(git ls-files | grep -Ei '(\.env$|\.pem$|\.key$|token|secret|credential)' | grep -v '^\.env\.example$' || true)
  if [[ -n "$suspect" ]]; then
    echo -e "${red}✗ Push blocked:${nc} suspicious tracked filenames detected:"
    echo "$suspect"
    exit 1
  fi
fi

# Site-contract guard. `site-manifest.json` is the published-artifact manifest:
# edit index.html or any served asset without regenerating it and CI's very
# first step fails with "manifest is STALE or invalid". That happened on
# 2026-08-27 (run 33118691742) and it is the one red this repo can produce
# without anything actually being wrong with the site.
#
# Note for anyone tempted to prove this gate works by pushing a knowingly broken
# commit to main: do not. `scripts/test-negative-controls.mjs` runs in every CI
# run and already proves every checker here is able to fail. A deliberate red on
# main costs the estate an alert email and proves nothing new.
if [ "${SITE_CONTRACT_SKIP:-0}" != "1" ] && command -v node >/dev/null 2>&1; then
  if ! node "$(git rev-parse --show-toplevel)/scripts/check-manifest.mjs" >/dev/null 2>&1; then
    echo -e "${red}✗ Push blocked:${nc} site-manifest.json does not match the working tree."
    echo    "  Regenerate and commit it:  node scripts/generate-manifest.mjs"
    echo    "  Full detail:               node scripts/check-manifest.mjs"
    exit 1
  fi
fi

echo -e "${green}✓ pre-push checks passed${nc}"

# Release-notes guard — managed policy, hand-merged because this repo owns its
# hooksPath. Escape hatch for a genuine emergency:  RELEASE_NOTES_SKIP=1 git push
if [ "${RELEASE_NOTES_SKIP:-0}" != "1" ]; then
  rn=/opt/automancer/auto/scripts/release-notes.mjs
  repo="$(git rev-parse --show-toplevel)"
  # Fail CLOSED: never fall back to a guessed branch name when the deploy refs
  # cannot be determined — that silently unguards any repo not deploying "main".
  if ! deploy_refs="$(node "$rn" deploy-refs --repo "$repo")"; then
    echo "release-notes: could not determine this repo's deploy refs — refusing to push unchecked." >&2
    echo "  Diagnose with:  node \"$rn\" deploy-refs --repo \"$repo\"" >&2
    echo "  Genuine emergency only:  RELEASE_NOTES_SKIP=1 git push ..." >&2
    exit 1
  fi
  seen=0
  while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ -n "$local_sha" ] && seen=$((seen + 1))
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    for name in $deploy_refs; do
      [ "$remote_ref" = "refs/heads/$name" ] || continue
      node "$rn" guard --repo "$repo" --ref "$local_sha" || exit 1
    done
  done <<<"$REFS"
  # A guard that cannot see the refs must not report a clear one. But "no refs"
  # has two causes and only one is a bug:
  #   * git offered nothing to push (up to date, or a non-fast-forward it
  #     rejected before running this hook) — REFS is empty and there is
  #     genuinely nothing to guard;
  #   * git offered refs and this loop parsed none of them, which means an
  #     earlier check consumed stdin and the guard is inspecting thin air.
  # Fail closed on the second only. Blocking the first is a false alarm that
  # makes every ordinary behind-origin push look like a guard failure.
  if [ "$seen" -eq 0 ] && [ -n "${REFS//[[:space:]]/}" ]; then
    echo "release-notes: git offered refs but this guard parsed none — an earlier check consumed stdin." >&2
    echo "  Move the release-notes block ABOVE it, or capture the ref list once and replay it to both." >&2
    exit 1
  fi
fi
