#!/usr/bin/env bash
set -euo pipefail

# git feeds a pre-push hook its ref list on STDIN exactly ONCE, and the gitleaks
# scan below drains stdin while it runs. Capture the list up front so anything
# added after this block can still see the refs.
REFS="$(cat)"

red='\033[0;31m'; yellow='\033[1;33m'; green='\033[0;32m'; nc='\033[0m'

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --redact --config .gitleaks.toml --no-banner --log-opts=HEAD >/dev/null 2>&1; then
    echo -e "${red}✗ Push blocked:${nc} gitleaks found potential secrets in repository history."
    echo -e "Run: gitleaks git --redact --config .gitleaks.toml --log-opts=HEAD"
    exit 1
  fi
else
  echo -e "${yellow}! gitleaks not installed; running basic fallback scan.${nc}"
  # Matches secret-carrying FILE SHAPES only. It used to also match the bare
  # words token|secret|credential anywhere in a path, which blocks a repo that
  # legitimately tracks secrets.ts or credentials.md -- permanently, with no
  # remediation. gitleaks scans content; this fallback only exists for a device
  # that has no gitleaks at all.
  suspect=$(git ls-files | grep -Ei '(^|/)(\.env$|\.env\..+|.*\.pem$|.*\.key$|.*\.token$|.*credentials\.json$|id_rsa$)' | grep -vE '^\.env\.(example|sample|template)$' || true)
  if [[ -n "$suspect" ]]; then
    echo -e "${red}✗ Push blocked:${nc} suspicious tracked filenames detected:"
    echo "$suspect"
    exit 1
  fi
fi

# Site-contract guard. `site-manifest.json` is the published-artifact manifest:
# edit index.html or any served asset without regenerating it and CI's very
# first step fails with "manifest is STALE or invalid". That happened on
# 2026-08-27 (run 33118691742) and it is the one red this repo can produce
# without anything actually being wrong with the site.
#
# Note for anyone tempted to prove this gate works by pushing a knowingly broken
# commit to main: do not. `scripts/test-negative-controls.mjs` runs in every CI
# run and already proves every checker here is able to fail. A deliberate red on
# main costs the estate an alert email and proves nothing new.
if [ "${SITE_CONTRACT_SKIP:-0}" != "1" ] && command -v node >/dev/null 2>&1; then
  if ! node "$(git rev-parse --show-toplevel)/scripts/check-manifest.mjs" >/dev/null 2>&1; then
    echo -e "${red}✗ Push blocked:${nc} site-manifest.json does not match the working tree."
    echo    "  Regenerate and commit it:  node scripts/generate-manifest.mjs"
    echo    "  Full detail:               node scripts/check-manifest.mjs"
    exit 1
  fi
fi

echo -e "${green}✓ pre-push checks passed${nc}"
